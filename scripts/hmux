#!/usr/bin/env python3
"""hmux — herdr-native ATM team launcher (MVP duplicate of `scripts/rmux`).

Reads [rmux] config from .atm.toml (or --config), then launches an ATM team
into herdr (workspace = ATM_TEAM, pane label = ATM_IDENTITY).

Usage:
    hmux [--config <path>] [--dry-run] [-v] [-h]
    hmux launch <pane-name> [--config <path>] [--dry-run] [-v]
    hmux codex|claude|sonnet|haiku|opus|fable|gemini|hermes <n> [OPTIONS]

Backend = herdr (via hmux_backend). Launch-core = hmux_core (shared with rmux
semantics). Install: cp hmux hmux_core.py hmux_backend.py ~/.local/bin/
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import hmux_core as core
import hmux_backend as backend

KNOWN_AGENT_TYPES = ("codex", "claude", "sonnet", "haiku", "opus", "fable",
                     "gemini", "hermes")


# ── helpers ────────────────────────────────────────────────────────────

def _err(msg: str) -> None:
    print(f"hmux: {msg}", file=sys.stderr)


def _pane_number(pane_id: str) -> int:
    """'w5:p2' -> 2."""
    try:
        return int(pane_id.rsplit(":p", 1)[1])
    except (IndexError, ValueError):
        return 0


def _root_tab_and_pane(workspace_id: str):
    """Best-effort root tab + pane of a workspace: tab with min number, then
    the pane in that tab with min pane number."""
    tabs = sorted(backend.tab_list(workspace_id), key=lambda t: t["number"])
    if not tabs:
        return "", ""
    root_tab_id = tabs[0]["tab_id"]
    panes = [p for p in backend.pane_list(workspace_id) if p["tab_id"] == root_tab_id]
    if not panes:
        return root_tab_id, ""
    root_pane = min(panes, key=lambda p: _pane_number(p["pane_id"]))
    return root_tab_id, root_pane["pane_id"]


def _find_or_create_workspace(team: str) -> dict:
    """Returns {workspace_id, root_pane_id, tab_id}."""
    ws_id = backend.workspace_find_by_label(team)
    if ws_id is None:
        return backend.workspace_create(team)
    tab_id, pane_id = _root_tab_and_pane(ws_id)
    return {"workspace_id": ws_id, "root_pane_id": pane_id, "tab_id": tab_id}


def _agent_matches_pane(agent: dict | None, pane_id: str) -> bool:
    """Return whether a parsed Herdr agent envelope belongs to pane_id."""
    if not agent:
        return False
    result = agent.get("result", {})
    info = result.get("agent", {}) if isinstance(result, dict) else {}
    return isinstance(info, dict) and info.get("pane_id") == pane_id


def _agent_name_taken(target: str, pane_id: str) -> dict | None:
    """Return the OTHER agent already using `target`, if any.

    Herdr agent names are a machine-wide namespace: one name maps to exactly
    one pane across ALL workspaces/teams. Teams that reuse a common member name
    (team-lead, quality-mgr, publisher) must carry a distinct alias; this guard
    enforces that invariant before any rename.
    """
    try:
        agents = backend.agent_list()
    except backend.HerdrError as error:
        print(f"WARN: could not list herdr agents for uniqueness check: {error}", file=sys.stderr)
        return None
    for agent in agents:
        if agent.get("name") == target and agent.get("pane_id") != pane_id:
            return agent
    return None


def _reject_collision(target: str, pane_id: str) -> bool:
    """Return True (and print an error) when `target` is used by another pane."""
    other = _agent_name_taken(target, pane_id)
    if other is None:
        return False
    print(
        f"ERROR: herdr agent name '{target}' is already in use by pane "
        f"{other.get('pane_id')} (workspace {other.get('workspace_id')}); herdr agent "
        f"names must be unique across ALL teams — set a distinct alias in .atm.toml "
        f"or the roster",
        file=sys.stderr,
    )
    return True


def _roster_members(team: str, identity: str = "") -> list[dict]:
    """Read the ATM roster, preserving the roster as target authority.

    `atm` rejects every call that has no identity, including this read-only one,
    so the caller's identity is passed through. Any member identity is accepted.
    """
    proc = subprocess.run(
        ["atm", "members", "--team", team, "--json"],
        capture_output=True,
        text=True,
        env={**os.environ, "ATM_TEAM": team, "ATM_IDENTITY": identity or "hmux"},
    )
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or "no diagnostic"
        raise RuntimeError(f"atm members failed: {detail}")
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"atm members returned non-JSON: {proc.stdout[:200]!r}") from error
    members = data.get("members", [])
    return members if isinstance(members, list) else []


def _resolve_herdr_target(team: str, identity: str, config_alias: str = "") -> str:
    """Resolve the Herdr target from the ATM roster, with config fallback."""
    fallback = config_alias or identity
    try:
        member = next(
            (m for m in _roster_members(team, identity) if isinstance(m, dict) and m.get("name") == identity),
            None,
        )
    except (OSError, RuntimeError) as error:
        print(f"WARN: could not read ATM roster for member '{identity}': {error}; using '{fallback}'", file=sys.stderr)
        return fallback

    if member is None:
        print(
            f"WARN: ATM member '{identity}' is not registered in team '{team}'; using '{fallback}'",
            file=sys.stderr,
        )
        return fallback

    name = member.get("name", identity)
    if "alias" in member:
        roster_alias = member.get("alias") or ""
    else:
        extra = member.get("extra")
        roster_alias = extra.get("alias", "") if isinstance(extra, dict) else ""
    if roster_alias:
        if config_alias and config_alias != roster_alias:
            print(
                f"ERROR: config alias '{config_alias}' for member '{name}' differs from "
                f"roster alias '{roster_alias}'; using roster alias",
                file=sys.stderr,
            )
        return roster_alias

    if config_alias:
        update = subprocess.run(
            ["atm", "teams", "update-member", team, name, "--alias", config_alias],
            capture_output=True,
            text=True,
            # update-member is team-scoped: the caller team must equal the target
            # team and the caller must be a member. Without this override the
            # call inherits the ambient (usually hermes) team and is rejected.
            env={**os.environ, "ATM_TEAM": team, "ATM_IDENTITY": name},
        )
        if update.returncode == 0:
            return config_alias
        if update.stderr:
            print(update.stderr, file=sys.stderr, end="" if update.stderr.endswith("\n") else "\n")
        # Rule: the Herdr agent name is (alias ?? name). A configured alias is
        # the target even when persisting it to the roster was rejected.
        return config_alias
    return name


_SHELLS = {"zsh", "bash", "sh", "dash", "fish", "ksh"}


def _ensure_command_started(pane_id: str, *, waits: int = 12, step_s: float = 0.25) -> bool:
    """Make sure `pane run` actually executed the command.

    A freshly split pane may still be initialising its shell, in which case herdr
    delivers the text but loses the Enter: the command sits at the prompt and the
    agent never registers. Detect a shell still in the foreground and press Enter
    once more.
    """
    for _ in range(waits):
        try:
            info = backend.pane_process_info(pane_id)
        except (backend.HerdrError, KeyError, TypeError, OSError):
            return False
        procs = info.get("foreground_processes") or []
        names = {str(p.get("name") or p.get("argv0") or "").lstrip("-")
                 for p in procs if isinstance(p, dict)}
        if names and not names <= _SHELLS:
            return True
        time.sleep(step_s)
    try:
        backend.pane_send_key(pane_id, "Enter")
    except (backend.HerdrError, KeyError, TypeError, OSError) as error:
        print(f"WARN: could not resend Enter to pane {pane_id}: {error}", file=sys.stderr)
        return False
    return True


def _register_herdr_agent(pane_id: str, target: str) -> bool:
    """Wait for a new pane agent, rename it to the ATM target, and verify it."""
    manual = f"herdr agent rename {pane_id} {target}"
    if _reject_collision(target, pane_id):
        return False
    for attempt in range(30):
        try:
            if _agent_matches_pane(backend.agent_get(pane_id), pane_id):
                backend.agent_rename(pane_id, target)
                if _agent_matches_pane(backend.agent_get(target), pane_id):
                    print(f"registered herdr agent '{target}' for pane {pane_id}")
                    return True
                raise backend.HerdrError(
                    f"agent target '{target}' did not resolve to pane {pane_id} after rename"
                )
        except backend.HerdrError as error:
            print(
                f"WARN: failed to register Herdr agent for pane {pane_id}: {error}; "
                f"manual repair: {manual}",
                file=sys.stderr,
            )
            return False
        if attempt < 29:
            time.sleep(1)

    print(
        f"WARN: timed out waiting for Herdr agent in pane {pane_id}; "
        f"manual repair: {manual}",
        file=sys.stderr,
    )
    return False


def _repair_existing_herdr_agent(pane_id: str, target: str, *, report: bool = False,
                                  expect_agent: bool = True) -> bool:
    """Repair an existing pane's non-durable Herdr agent name without rerunning it.

    `expect_agent` is False for plain terminal panes (empty command): there is
    no agent to (re)name, so return immediately. Otherwise poll for Herdr to
    detect the agent, then rename it to `target` and verify.
    """
    if not expect_agent:
        return True
    manual = f"herdr agent rename {pane_id} {target}"
    if _reject_collision(target, pane_id):
        return False
    for attempt in range(30):
        try:
            if _agent_matches_pane(backend.agent_get(target), pane_id):
                if report:
                    print(f"already correct herdr agent '{target}' for pane {pane_id}")
                return True
            if backend.agent_get(pane_id) is None:
                if report:
                    print(f"no agent yet for pane {pane_id}")
            else:
                backend.agent_rename(pane_id, target)
                if _agent_matches_pane(backend.agent_get(target), pane_id):
                    if report:
                        print(f"renamed herdr agent '{target}' for pane {pane_id}")
                    return True
                raise backend.HerdrError(
                    f"agent target '{target}' did not resolve to pane {pane_id} after rename"
                )
        except backend.HerdrError as error:
            print(
                f"WARN: failed to repair Herdr agent for pane {pane_id}: {error}; "
                f"manual repair: {manual}",
                file=sys.stderr,
            )
            return False
        if attempt < 29:
            time.sleep(1)

    print(
        f"WARN: timed out waiting for Herdr agent in pane {pane_id}; "
        f"manual repair: {manual}",
        file=sys.stderr,
    )
    return False


def rename_agents(cfg: core.RmuxConfig, team: str) -> int:
    """Reapply each labeled pane's Herdr agent name after a server restart."""
    workspace_id = backend.workspace_find_by_label(team)
    if workspace_id is None:
        _err(f"workspace '{team}' not found")
        return 1

    failed = False
    for pane in backend.pane_list(workspace_id):
        label = pane["label"]
        if not label:
            continue
        configured = next(
            (
                candidate
                for window in cfg.windows
                for candidate in window.panes
                if core.resolve_pane_label(candidate) == label
            ),
            None,
        )
        config_alias = configured.alias if configured is not None else ""
        target = _resolve_herdr_target(team, label, config_alias)
        expect_agent = bool(core.resolve_pane_tool(configured)) if configured is not None else True
        if not _repair_existing_herdr_agent(pane["pane_id"], target, report=True,
                                            expect_agent=expect_agent):
            failed = True
    return 1 if failed else 0


# ── session mode (S-4) ─────────────────────────────────────────────────

def _split_direction(pi: int) -> str:
    """Alternate right/down for successive panes (deterministic; layout IGNORED)."""
    return "right" if pi % 2 == 1 else "down"


def run_session(cfg: core.RmuxConfig, team: str, dry_run: bool, shell: str = "",
                resume: bool = False) -> int:
    if dry_run:
        print(core.dry_run_projection(cfg, team, mode="session", shell=shell, resume=resume))
        return 0

    ws = _find_or_create_workspace(team)
    workspace_id = ws["workspace_id"]

    registration_failed = False
    for wi, window in enumerate(cfg.windows):
        if not window.panes:
            continue

        if wi == 0:
            tab_id = ws["tab_id"]
            root_pane_id = ws["root_pane_id"]
        else:
            created = backend.tab_create(workspace_id, window.name)
            tab_id = created["tab_id"]
            root_pane_id = created["root_pane_id"]

        prev_pane_id = root_pane_id
        for pi, pane in enumerate(window.panes):
            label = core.resolve_pane_label(pane)
            target = _resolve_herdr_target(team, label, pane.alias)
            existing_pane_id = backend.pane_find_by_label(workspace_id, label)
            if existing_pane_id is not None:
                pane_id = existing_pane_id
                expect_agent = bool(core.resolve_pane_tool(pane))
                if not _repair_existing_herdr_agent(pane_id, target,
                                                    expect_agent=expect_agent):
                    registration_failed = True
                prev_pane_id = pane_id
                print(f"launched pane '{label}' ({pane_id})")
                continue

            if pi == 0:
                pane_id = root_pane_id
            else:
                pane_id = backend.pane_split(prev_pane_id, _split_direction(pi))

            backend.pane_rename(pane_id, label)

            resume_sid = ""
            if resume:
                tool = core.resolve_pane_tool(pane)
                resume_sid = core.resolve_resume_session_id(cfg.env_dir, tool, label)
                if resume_sid:
                    print(f"resuming pane '{label}' from session {resume_sid}")
                else:
                    print(f"no session found for pane '{label}'; starting fresh")

            init = core.build_init_cmd(pane, cfg.env_dir, "session", shell=shell)
            full = core.build_pane_commands(pane, team, shell=shell, resume_session_id=resume_sid)
            command = f"{init}; {full}".strip("; ")
            if command:
                backend.pane_run(pane_id, command)
                _ensure_command_started(pane_id)
                if full and not _register_herdr_agent(pane_id, target):
                    registration_failed = True
            prev_pane_id = pane_id
            print(f"launched pane '{label}' ({pane_id})")

    print(f"Session '{team}' launched (workspace {workspace_id}).")
    return 1 if registration_failed else 0


# ── launch mode (S-5) ──────────────────────────────────────────────────

def run_launch(cfg: core.RmuxConfig, team: str, pane_name: str, dry_run: bool, shell: str = "",
               resume: bool = False) -> int:
    # config lookup by name
    target = None
    target_win = None
    for wi, window in enumerate(cfg.windows):
        for pane in window.panes:
            if pane.name == pane_name:
                target, target_win = pane, wi
                break
        if target is not None:
            break

    if target is None:
        _err(f"pane '{pane_name}' not found in config")
        sys.exit(1)

    label = core.resolve_pane_label(target)
    resume_sid = ""
    if resume:
        tool = core.resolve_pane_tool(target)
        resume_sid = core.resolve_resume_session_id(cfg.env_dir, tool, label)
        if resume_sid:
            print(f"resuming pane '{label}' from session {resume_sid}")
        else:
            print(f"no session found for pane '{label}'; starting fresh")
    init = core.build_init_cmd(target, cfg.env_dir, "session", shell=shell)
    full = core.build_pane_commands(target, team, shell=shell, resume_session_id=resume_sid)
    command = f"{init}; {full}".strip("; ")

    if dry_run:
        window = cfg.windows[target_win]
        print(f"=== hmux launch dry-run: {pane_name} ===")
        print(f"  workspace: {team}")
        print(f"  window: {window.name} (layout: {window.layout})")
        print()
        print(f"  Pane: \"{target.name}\"")
        if init:
            print(f"    init: {init}")
        if full:
            print(f"    cmd: {full}")
        print()
        print("Run without --dry-run to launch pane.")
        return 0

    ws = _find_or_create_workspace(team)
    workspace_id = ws["workspace_id"]
    herdr_target = _resolve_herdr_target(team, label, target.alias)

    # runtime match by label (resolved identity)
    existing_pane_id = backend.pane_find_by_label(workspace_id, label)
    pane_id = existing_pane_id
    if pane_id is None:
        # ensure the window's tab exists, then split a new pane
        tab_id = None
        window = cfg.windows[target_win]
        for t in backend.tab_list(workspace_id):
            if t["label"] == window.name:
                tab_id = t["tab_id"]
                break
        if tab_id is None:
            created = backend.tab_create(workspace_id, window.name)
            tab_id = created["tab_id"]
            base_pane = created["root_pane_id"]
        else:
            # split from the tab's last pane
            panes = sorted(
                [p for p in backend.pane_list(workspace_id) if p["tab_id"] == tab_id],
                key=lambda p: _pane_number(p["pane_id"]),
            )
            base_pane = panes[-1]["pane_id"] if panes else ""
        pane_id = backend.pane_split(base_pane, "down") if base_pane else ""
        if pane_id:
            backend.pane_rename(pane_id, label)
        else:
            _err(f"could not create pane for '{pane_name}'")
            sys.exit(1)

    registration_failed = False
    if existing_pane_id is not None:
        expect_agent = bool(core.resolve_pane_tool(target))
        registration_failed = not _repair_existing_herdr_agent(pane_id, herdr_target,
                                                               expect_agent=expect_agent)
    elif command:
        backend.pane_run(pane_id, command)
        _ensure_command_started(pane_id)
        if full:
            registration_failed = not _register_herdr_agent(pane_id, herdr_target)
    print(f"Launched '{pane_name}' in pane {pane_id}.")
    return 1 if registration_failed else 0


# ── spawn mode (S-5) ───────────────────────────────────────────────────

def _parent_session_id(team: str) -> str:
    """Read leadSessionId from ~/.claude/teams/<team>/config.json (rmux:82-93)."""
    import json
    path = os.path.expanduser(f"~/.claude/teams/{team}/config.json")
    if not os.path.isfile(path):
        return ""
    try:
        with open(path) as f:
            return json.load(f).get("leadSessionId", "")
    except Exception:
        return ""


def run_spawn(cfg: core.RmuxConfig, spawn_type: str, spawn_name: str,
              cli_team: str, model: str, window: str, dry_run: bool, shell: str = "") -> int:
    team = core.resolve_team(cfg, "spawn", cli_team=cli_team or None)

    # resolve model + parent session id
    resolved_model = model or core.DEFAULT_SPAWN_MODEL.get(spawn_type, "")
    parent_session_id = _parent_session_id(team)

    # Synthetic pane for the spawn init command. If a matching config pane
    # exists, retain its alias as the roster's Herdr target.
    configured = next(
        (pane for window_cfg in cfg.windows for pane in window_cfg.panes if pane.name == spawn_name),
        None,
    )
    synth = core.Pane(name=spawn_name, env={
        "ATM_IDENTITY": spawn_name,
        "ATM_TEAM": team,
    }, alias=configured.alias if configured else "",
       agent_type=configured.agent_type if configured else "")
    init = core.build_init_cmd(synth, cfg.env_dir, "spawn", shell=shell)
    full = core.build_spawn_commands(team, spawn_type, spawn_name,
                                     model=model, parent_session_id=parent_session_id,
                                     shell=shell)
    command = f"{init}; {full}".strip("; ")

    if dry_run:
        print("=== hmux spawn dry-run ===")
        print(f"  workspace: {team}")
        print(f"  window:  {window}")
        print(f"  pane:    {spawn_name}")
        print(f"  type:    {spawn_type}")
        print(f"  team:    {team}")
        if resolved_model:
            print(f"  model:   {resolved_model}")
        if parent_session_id:
            print(f"  parent:  {parent_session_id}")
        print(f"  init:    {init}")
        print(f"  cmd:     {full}")
        return 0

    ws = _find_or_create_workspace(team)
    workspace_id = ws["workspace_id"]

    # find or create the target window (tab)
    tab_id = None
    for t in backend.tab_list(workspace_id):
        if t["label"] == window:
            tab_id = t["tab_id"]
            break

    if tab_id is None:
        created = backend.tab_create(workspace_id, window)
        tab_id = created["tab_id"]
        base_pane = created["root_pane_id"]
    else:
        panes = sorted(
            [p for p in backend.pane_list(workspace_id) if p["tab_id"] == tab_id],
            key=lambda p: _pane_number(p["pane_id"]),
        )
        base_pane = panes[-1]["pane_id"] if panes else ""

    pane_id = backend.pane_split(base_pane, "down")
    backend.pane_rename(pane_id, spawn_name)
    backend.pane_run(pane_id, command)
    _ensure_command_started(pane_id)

    herdr_target = _resolve_herdr_target(team, spawn_name, synth.alias)
    registration_failed = not _register_herdr_agent(pane_id, herdr_target)

    # Register a Herdr-backed member; pane ids are not tmux targets.
    add_member = [
        "atm", "teams", "add-member", team, spawn_name,
        "--agent-type", (synth.agent_type or spawn_name), "--backend", "herdr",
    ]
    session = os.environ.get("HERDR_SESSION", "").strip()
    if session and session != "default":
        add_member += ["--session", session]
    if herdr_target != spawn_name:
        add_member += ["--alias", herdr_target]
    proc = subprocess.run(
        add_member,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        registration_failed = True
        detail = proc.stderr.strip() or proc.stdout.strip() or "no diagnostic"
        _err(f"atm teams add-member failed for '{spawn_name}': {detail}")
        print(
            f"WARN: failed to register ATM member for pane {pane_id}; "
            f"manual repair: herdr agent rename {pane_id} {herdr_target}",
            file=sys.stderr,
        )

    print(f"Spawned '{spawn_name}' ({spawn_type}) in {team}:{window} pane {pane_id}")
    return 1 if registration_failed else 0


# ── bare-agent launch (hmux <agent>) ───────────────────────────────────


def _find_pane(cfg: core.RmuxConfig, name: str):
    """Find a pane by name or alias. Returns (pane, window_index) or (None, None)."""
    for wi, window in enumerate(cfg.windows):
        for pane in window.panes:
            if pane.name == name or (pane.alias and pane.alias == name):
                return pane, wi
    return None, None


def _agent_running(*targets: str) -> str:
    """Describe where this agent is already running, or '' when it is not.

    A herdr entry only counts as running while its agent is working or idle:
    `done`/`unknown` means the harness exited and the pane is a bare shell,
    which is exactly the case this shorthand exists to recover from.
    """
    names = {t for t in targets if t}
    current = os.environ.get("ATM_IDENTITY", "")
    if current and current in names:
        return f"this pane is already running '{current}'"
    try:
        for agent in backend.agent_list():
            name = agent.get("name") or agent.get("agent") or ""
            status = agent.get("agent_status") or ""
            if name in names and status in ("working", "idle"):
                return (f"herdr agent '{name}' is {status} "
                        f"(pane {agent.get('pane_id', '?')}, cwd {agent.get('cwd', '?')})")
    except Exception:  # herdr unavailable: fall back to the process table
        pass
    for pattern in (f"--agent-id {t}@" for t in names):
        proc = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
        if proc.returncode == 0:
            pids = " ".join(proc.stdout.split()[:3])
            return f"a process matching '{pattern.strip('@')}@' is running (pid {pids})"
    return ""


def run_agent_here(cfg: core.RmuxConfig, team: str, pane_name: str, dry_run: bool,
                   shell: str = "") -> int:
    """Launch one configured agent in the CURRENT pane, refusing when it already runs.

    This is the `hmux <agent>` shorthand: the operator stands in an empty pane,
    names a member from .atm.toml, and that pane becomes the agent. Unlike
    `hmux launch`, nothing is typed into a herdr pane -- the command runs here.
    """
    target, target_win = _find_pane(cfg, pane_name)
    if target is None:
        _err(f"'{pane_name}' is not a pane in this config, and not a mode "
             f"(session, launch, rename-agents)")
        return 1

    label = core.resolve_pane_label(target)
    herdr_target = _resolve_herdr_target(team, label, target.alias)
    running = _agent_running(label, herdr_target, target.alias or "", target.name)
    if running:
        print(f"hmux: not launching '{label}' — {running}")
        return 1

    init = core.build_init_cmd(target, cfg.env_dir, "session", shell=shell)
    commands = core.build_pane_commands(target, team, shell=shell)
    full = f"{init}; {commands}".strip("; ")

    if dry_run:
        window = cfg.windows[target_win]
        print(f"=== hmux {pane_name} dry-run ===")
        print(f"  workspace: {team}")
        print(f"  window: {window.name} (layout: {window.layout})")
        print(f"  label: {label}")
        if init:
            print(f"  init: {init}")
        if commands:
            print(f"  cmd: {commands}")
        return 0

    print(f"hmux: launching '{label}' here (window {window_name(cfg, target_win)})")
    try:
        return subprocess.call(full, shell=True, cwd=cfg.env_dir)
    except KeyboardInterrupt:
        return 130


def window_name(cfg: core.RmuxConfig, index: int) -> str:
    return cfg.windows[index].name if 0 <= index < len(cfg.windows) else "?"


# ── main ───────────────────────────────────────────────────────────────

def main(argv) -> int:
    if argv and not argv[0].startswith("-") \
            and argv[0] not in KNOWN_AGENT_TYPES \
            and argv[0] not in ("session", "launch", "rename-agents"):
        # bare-agent shorthand: hmux <agent>
        parser = argparse.ArgumentParser(prog=f"hmux {argv[0]}")
        parser.add_argument("--config", default=".atm.toml")
        parser.add_argument("--shell", default="", choices=["bash", "pwsh"],
                            help="Target pane shell dialect (default: auto by platform)")
        parser.add_argument("--dry-run", action="store_true")
        args = parser.parse_args(argv[1:])
        cfg = core.load_config(args.config)
        team = core.resolve_team(cfg, "session")
        return run_agent_here(cfg, team, argv[0], args.dry_run, args.shell)

    if len(argv) >= 2 and argv[0] in KNOWN_AGENT_TYPES:
        # spawn mode: hmux <type> <name> [opts]
        spawn_type, spawn_name = argv[0], argv[1]
        parser = argparse.ArgumentParser(prog=f"hmux {spawn_type} {spawn_name}")
        parser.add_argument("--config", default=".atm.toml")
        parser.add_argument("--team", default="")
        parser.add_argument("--model", default="")
        parser.add_argument("--window", default="spare")
        parser.add_argument("--shell", default="", choices=["bash", "pwsh"],
                            help="Target pane shell dialect (default: auto by platform)")
        parser.add_argument("--dry-run", action="store_true")
        args = parser.parse_args(argv[2:])
        cfg = core.load_config(args.config)
        return run_spawn(cfg, spawn_type, spawn_name, args.team, args.model,
                         args.window, args.dry_run, args.shell)

    parser = argparse.ArgumentParser(prog="hmux")
    parser.add_argument("mode", nargs="?", default="session",
                        choices=["session", "launch", "rename-agents"])
    parser.add_argument("pane_name", nargs="?")
    parser.add_argument("--config", default=".atm.toml")
    parser.add_argument("--shell", default="", choices=["bash", "pwsh"],
                        help="Target pane shell dialect (default: auto by platform)")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--resume", action="store_true",
                        help="Look up each member's most recent session in .sc/sessions/ and resume it; panes without a session start fresh")
    parser.add_argument("-v", "--verbose", action="store_true")
    args = parser.parse_args(argv)

    if args.mode == "rename-agents":
        if not args.pane_name:
            _err("rename-agents: team required")
            return 1
        cfg = core.load_config(args.config)
        return rename_agents(cfg, args.pane_name)

    if args.mode == "launch":
        if not args.pane_name:
            _err("launch: pane name required")
            return 1
        cfg = core.load_config(args.config)
        team = core.resolve_team(cfg, "session")
        return run_launch(cfg, team, args.pane_name, args.dry_run, args.shell, args.resume)

    cfg = core.load_config(args.config)
    team = core.resolve_team(cfg, "session")
    return run_session(cfg, team, args.dry_run, args.shell, args.resume)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
